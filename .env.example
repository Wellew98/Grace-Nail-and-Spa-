# Copy to .env.local and fill in. Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. NEVER prefix this NEXT_PUBLIC_. It bypasses every RLS policy.
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email (spec §8 Phase 2: confirmation to customer + owner)
RESEND_API_KEY=
BOOKING_FROM_EMAIL=
OWNER_NOTIFICATION_EMAIL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local acceptance-test database (spec §9). Not used in production.
TEST_DATABASE_URL=postgresql://postgres@/postgres?host=/tmp&port=5433
