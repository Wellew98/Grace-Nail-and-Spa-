# Copy to .env.local and fill in. Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=

# The public, RLS-gated key. Set whichever your dashboard gave you — newer
# Supabase projects issue `sb_publishable_…`, older ones a JWT anon key. Both
# are public by design and safe in the browser; RLS is what gates them.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. NEVER prefix either of these NEXT_PUBLIC_ — both bypass RLS.
#
# The booking engine uses SUPABASE_DB_URL (a direct Postgres connection), not
# the service role key: spec §6 needs a real transaction, §5 step 8 needs the
# raw SQLSTATE, and §9 test 1 needs a connection pool. See lib/db.ts.
# SUPABASE_SERVICE_ROLE_KEY is listed for completeness (spec §11) and is not
# currently read by any code path.
SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Transactional email — confirmation to the customer, notification to the owner.
# BLOCKING for launch (spec v2 §1.2).
#
# Sending is best-effort and never throws into the booking write path, which is
# correct — but it means a misconfigured mailer is completely SILENT. The
# customer books, receives nothing, and phones to check. /api/health is the only
# thing that breaks that silence, so set these and then go and look at it.
#
# Pick ONE transport. lib/mail.ts infers it from whichever credentials are
# present; MAIL_TRANSPORT only needs setting to force the choice when both are.
# ---------------------------------------------------------------------------
# MAIL_TRANSPORT=                 # gmail | resend. Optional — inferred if unset.

# --- Option A: Gmail. Free, works with no domain. What the spa uses today. ---
# Deliverability is the best of the free options because the mail leaves Gmail
# claiming to be from Gmail, so SPF/DKIM/DMARC all align.
GMAIL_USER=                       # e.g. gracenailsspa@gmail.com — also the sender
GMAIL_APP_PASSWORD=               # Google Account > Security > App passwords.
                                  # 16 characters, shown in four groups of four.
                                  # Needs 2-Step Verification on the account.
                                  # NOT the account password — SMTP rejects that.

# --- Option B: Resend. Needs a domain you have verified. Switch to this ---
# --- once the spa owns one; nothing but these variables has to change.  ---
# RESEND_API_KEY=                 # Resend > API Keys. Starts re_
# BOOKING_FROM_EMAIL=             # MUST be on a domain verified in Resend.
                                  # Unset, the code falls back to
                                  # bookings@example.com, which Resend refuses
                                  # — so every send fails despite a valid key.
                                  # onboarding@resend.dev only delivers to your
                                  # own account address, never to a customer.

# --- Required either way ---
OWNER_NOTIFICATION_EMAIL=         # Where new bookings and cancellations go.
                                  # Unset, customers are emailed and she is not.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Booking assistant (lib/ai). Entirely optional: unset, getProvider() returns
# null, the assistant is simply not available, and every other path — the
# booking flow, the admin, the emails — is unaffected.
#
# SERVER ONLY. Never prefix any of these NEXT_PUBLIC_: that inlines the value
# into the browser bundle, which for an API key means every visitor can read it
# and spend it. providerConfigProblem() refuses to start the assistant if it
# finds one there.
# ---------------------------------------------------------------------------
AI_PROVIDER=                      # gemini. Optional — inferred from the key.
AI_MODEL=                         # e.g. gemini-2.5-flash. NO DEFAULT, deliberately:
                                  # a model name baked into the code outlives its
                                  # own deprecation and the first symptom is a 404
                                  # from the provider months later.
GEMINI_API_KEY=                   # aistudio.google.com > Get API key.
# AI_TIMEOUT_MS=                  # Optional. Default 20000, hard ceiling 60000.

# Local acceptance-test database (spec §9). Not used in production.
TEST_DATABASE_URL=postgresql://postgres@/postgres?host=/tmp&port=5433
